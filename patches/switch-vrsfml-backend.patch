diff --git a/include/SFML/Config.hpp b/include/SFML/Config.hpp
index a03cba5b8..68eaf8d1c 100644
--- a/include/SFML/Config.hpp
+++ b/include/SFML/Config.hpp
@@ -74,6 +74,12 @@
 
     #endif
 
+#elif defined(__SWITCH__)
+
+    // Nintendo Switch homebrew, built with devkitPro against libnx. Not a __unix__
