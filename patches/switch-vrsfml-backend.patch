diff --git a/cmake/Config.cmake b/cmake/Config.cmake
index 631d9e855..bcfc6a884 100644
--- a/cmake/Config.cmake
+++ b/cmake/Config.cmake
@@ -60,6 +60,14 @@ elseif(${CMAKE_SYSTEM_NAME} STREQUAL "Android")
     # use the OpenGL ES implementation on Android
     set(OPENGL_ES 1)
 
+elseif(NINTENDO_SWITCH)
+    message(STATUS "Detected Nintendo Switch")
+    set(SFML_OS_SWITCH 1)
+
+    # mesa/nouveau exposes desktop OpenGL 4.3 core on the Switch, not just GLES, and the
+    # desktop path is the one the engine's shaders target
+    set(OPENGL_ES 0)
+
 # comparing CMAKE_SYSTEM_NAME with "CYGWIN" generates a false warning depending on the CMake version
 # let's avoid it so the actual error is more visible
 elseif(${CYGWIN})
