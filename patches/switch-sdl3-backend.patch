diff --git a/src/time/unix/SDL_systime.c b/src/time/unix/SDL_systime.c
index b5ae56440..27ae40c14 100644
--- a/src/time/unix/SDL_systime.c
+++ b/src/time/unix/SDL_systime.c
@@ -195,13 +195,21 @@ bool SDL_TimeToDateTime(SDL_Time ticks, SDL_DateTime *dt, bool localTime)
          *
          * The notable exception is Solaris, where the timezone offset must still be retrieved in the strictly POSIX.1-2008
          * compliant way.
+         *
+         * The newlib that ships with libnx is a second exception: it does not expose
+         * tm_gmtoff either, so the Switch takes the same strictly POSIX.1-2008 path.
          */
-#if (_POSIX_VERSION >= 202405L) || (!defined(sun) && !defined(__sun))
+#if ((_POSIX_VERSION >= 202405L) || (!defined(sun) && !defined(__sun))) && !defined(SDL_PLATFORM_SWITCH)
         dt->utc_offset = (int)tm->tm_gmtoff;
 #else
         if (localTime) {
             tzset();
+#ifdef SDL_PLATFORM_SWITCH
+            // newlib names the offset _timezone rather than timezone
+            dt->utc_offset = (int)_timezone;
+#else
             dt->utc_offset = (int)timezone;
+#endif
         } else {
             dt->utc_offset = 0;
         }
