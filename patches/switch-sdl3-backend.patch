diff --git a/CMakeLists.txt b/CMakeLists.txt
index e591a011c..b81e32155 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -149,7 +149,9 @@ endif()
 #  for the time being. This default will change to ON once this becomes
 #  commonly supported in browsers or the Emscripten team makes a single
 #  binary work everywhere.
-if (UNIX_OR_MAC_SYS AND NOT EMSCRIPTEN)
+# libnx implements pthreads, so the Switch wants the pthread backend even though it is
+# not a UNIX_OR_MAC_SYS platform.
+if ((UNIX_OR_MAC_SYS OR SWITCH) AND NOT EMSCRIPTEN)
   set(SDL_PTHREADS_DEFAULT ON)
 else()
   set(SDL_PTHREADS_DEFAULT OFF)
@@ -3350,6 +3352,67 @@ elseif(N3DS)
     "${SDL3_SOURCE_DIR}/src/io/n3ds/*.h"
   )
 
+elseif(SWITCH)
+  # Nintendo Switch homebrew, built with devkitPro/devkitA64 against libnx.
+  #
+  # libnx ships newlib with real pthreads, clock_gettime and the usual POSIX file
+  # entry points, so unlike the Vita and 3DS ports most of SDL's plumbing reuses the
+  # generic backends instead of needing bespoke implementations. Only video, audio and
+  # joystick genuinely need Switch-specific code; until those land, the dummy fallbacks
+  # further down this file fill them in so the rest of the library can be built and
+  # linked.
+  sdl_glob_sources("${SDL3_SOURCE_DIR}/src/main/generic/*.c")
+
+  CheckPTHREAD()
+
+  set(SDL_FSOPS_POSIX 1)
+  sdl_sources("${SDL3_SOURCE_DIR}/src/filesystem/posix/SDL_sysfsops.c")
+  set(HAVE_SDL_FSOPS TRUE)
+
+  set(SDL_TIME_UNIX 1)
+  sdl_glob_sources("${SDL3_SOURCE_DIR}/src/time/unix/*.c")
+  set(HAVE_SDL_TIME TRUE)
+
+  set(SDL_TIMER_UNIX 1)
+  sdl_glob_sources("${SDL3_SOURCE_DIR}/src/timer/unix/*.c")
+  set(HAVE_SDL_TIMERS TRUE)
+
+  if(SDL_AUDIO)
+    set(SDL_AUDIO_DRIVER_SWITCH 1)
+    sdl_glob_sources(
+      "${SDL3_SOURCE_DIR}/src/audio/switch/*.c"
+      "${SDL3_SOURCE_DIR}/src/audio/switch/*.h"
+    )
+    set(HAVE_SDL_AUDIO TRUE)
+  endif()
+
+  if(SDL_JOYSTICK)
+    set(SDL_JOYSTICK_SWITCH 1)
+    sdl_glob_sources("${SDL3_SOURCE_DIR}/src/joystick/switch/*.c")
+    set(HAVE_SDL_JOYSTICK TRUE)
+  endif()
+
+  if(SDL_VIDEO)
+    set(SDL_VIDEO_DRIVER_SWITCH 1)
+    sdl_glob_sources(
+      "${SDL3_SOURCE_DIR}/src/video/switch/*.c"
+      "${SDL3_SOURCE_DIR}/src/video/switch/*.h"
+    )
+    set(HAVE_SDL_VIDEO TRUE)
+
+    # mesa/nouveau reaches the Switch GPU through EGL and exposes desktop OpenGL 4.3
+    # core as well as GLES 3.2. SDL's shared EGL layer binds whichever API the
+    # application asks for via gl_config.profile_mask, so both are advertised here.
+    set(SDL_VIDEO_OPENGL 1)
+    set(SDL_VIDEO_OPENGL_EGL 1)
+    set(SDL_VIDEO_OPENGL_ES2 1)
+
+    # libEGL is a static archive here, so it is linked directly rather than dlopen'd;
+    # the link order matters because EGL resolves through mesa's dispatch layer, which
+    # in turn sits on the nouveau kernel interface.
+    sdl_link_dependency(switch_video LIBS EGL glapi drm_nouveau)
+  endif()
+
 elseif(DOS)
   sdl_glob_sources("${SDL3_SOURCE_DIR}/src/main/dos/*.c")
   sdl_glob_sources("${SDL3_SOURCE_DIR}/src/core/dos/*.c")
