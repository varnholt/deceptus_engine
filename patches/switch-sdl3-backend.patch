+#include "SDL_internal.h"
+
+#ifndef SDL_switchaudio_h_
+#define SDL_switchaudio_h_
+
+#include "../SDL_sysaudio.h"
+
+#include <switch.h>
+
+// two buffers is enough to keep audout fed while SDL fills the other one
+#define SWITCH_AUDIO_BUFFER_COUNT 2
+
+struct SDL_PrivateAudioData
+{
+    AudioOutBuffer buffers[SWITCH_AUDIO_BUFFER_COUNT];
