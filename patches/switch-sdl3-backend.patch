diff --git a/src/thread/pthread/SDL_systhread.c b/src/thread/pthread/SDL_systhread.c
index fd16b2d8e..461be0d91 100644
--- a/src/thread/pthread/SDL_systhread.c
+++ b/src/thread/pthread/SDL_systhread.c
@@ -185,8 +185,10 @@ SDL_ThreadID SDL_GetCurrentThreadID(void)
 
 bool SDL_SYS_SetThreadPriority(SDL_ThreadPriority priority)
 {
-#ifdef SDL_PLATFORM_RISCOS
+#if defined(SDL_PLATFORM_RISCOS) || defined(SDL_PLATFORM_SWITCH)
     // FIXME: Setting thread priority does not seem to be supported
+    // libnx's pthread layer provides no pthread_getschedparam/pthread_setschedparam
