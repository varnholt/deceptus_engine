+
+#include "SDL_switchvideo.h"
+#include "SDL_switchopengl.h"
+
+static void SWITCH_Destroy(SDL_VideoDevice *device)
+{
+    SDL_free(device->internal);
+    SDL_free(device);
+}
+
+static SDL_VideoDevice *SWITCH_Create(void)
+{
+    SDL_VideoDevice *device;
+    SDL_VideoData *data;
+
+    // Initialize SDL_VideoDevice structure
+    device = (SDL_VideoDevice *)SDL_calloc(1, sizeof(SDL_VideoDevice));
+    if (!device) {
+        return NULL;
+    }
+
+    // Initialize internal data
+    data = (SDL_VideoData *)SDL_calloc(1, sizeof(SDL_VideoData));
+    if (!data) {
+        SDL_free(device);
+        return NULL;
+    }
+
+    device->internal = data;
+
+    device->num_displays = 0;
+    device->free = SWITCH_Destroy;
+
+    device->VideoInit = SWITCH_VideoInit;
+    device->VideoQuit = SWITCH_VideoQuit;
+    device->GetDisplayModes = SWITCH_GetDisplayModes;
+    device->SetDisplayMode = SWITCH_SetDisplayMode;
+    device->CreateSDLWindow = SWITCH_CreateWindow;
+    device->SetWindowTitle = SWITCH_SetWindowTitle;
+    device->SetWindowPosition = SWITCH_SetWindowPosition;
+    device->SetWindowSize = SWITCH_SetWindowSize;
+    device->ShowWindow = SWITCH_ShowWindow;
+    device->HideWindow = SWITCH_HideWindow;
+    device->DestroyWindow = SWITCH_DestroyWindow;
+
+#ifdef SDL_VIDEO_OPENGL_EGL
+    device->GL_LoadLibrary = SWITCH_GLES_LoadLibrary;
+    device->GL_GetProcAddress = SWITCH_GLES_GetProcAddress;
+    device->GL_UnloadLibrary = SWITCH_GLES_UnloadLibrary;
+    device->GL_CreateContext = SWITCH_GLES_CreateContext;
+    device->GL_MakeCurrent = SWITCH_GLES_MakeCurrent;
+    device->GL_SetSwapInterval = SWITCH_GLES_SetSwapInterval;
+    device->GL_GetSwapInterval = SWITCH_GLES_GetSwapInterval;
+    device->GL_SwapWindow = SWITCH_GLES_SwapWindow;
+    device->GL_DestroyContext = SWITCH_GLES_DestroyContext;
+#endif
+
+    device->PumpEvents = SWITCH_PumpEvents;
+
+    return device;
+}
+
+VideoBootStrap SWITCH_bootstrap = {
+    "switch",
+    "Nintendo Switch Video Driver",
+    SWITCH_Create,
+    NULL, // no ShowMessageBox implementation
+    false
+};
+
+/*****************************************************************************/
+// SDL Video and Display initialization/handling functions
+/*****************************************************************************/
+
+static void SWITCH_GetOperationModeSize(int *width, int *height)
+{
+    if (appletGetOperationMode() == AppletOperationMode_Console) {
+        *width = SWITCH_WIDTH_DOCKED;
+        *height = SWITCH_HEIGHT_DOCKED;
+    } else {
+        *width = SWITCH_WIDTH_HANDHELD;
+        *height = SWITCH_HEIGHT_HANDHELD;
+    }
+}
+
+bool SWITCH_VideoInit(SDL_VideoDevice *_this)
+{
+    SDL_VideoDisplay display;
+    SDL_DisplayMode mode;
+    int width, height;
+
+    SWITCH_GetOperationModeSize(&width, &height);
+
+    SDL_zero(mode);
+    mode.w = width;
+    mode.h = height;
+    mode.refresh_rate = SWITCH_REFRESH_RATE;
+    mode.format = SDL_PIXELFORMAT_ABGR8888;
+
+    SDL_zero(display);
+    display.name = "Nintendo Switch";
+    display.desktop_mode = mode;
+
+    if (SDL_AddVideoDisplay(&display, false) == 0) {
+        return false;
+    }
+
+    return true;
+}
+
+void SWITCH_VideoQuit(SDL_VideoDevice *_this)
+{
+}
+
+bool SWITCH_GetDisplayModes(SDL_VideoDevice *_this, SDL_VideoDisplay *display)
+{
+    SDL_DisplayMode mode;
+
+    /* Both scan-out resolutions are always offered. Which one is actually live
+     * depends on whether the console is docked, and the system switches between
+     * them on the fly when the user docks or undocks. */
+    SDL_zero(mode);
+    mode.refresh_rate = SWITCH_REFRESH_RATE;
+    mode.format = SDL_PIXELFORMAT_ABGR8888;
+
+    mode.w = SWITCH_WIDTH_HANDHELD;
+    mode.h = SWITCH_HEIGHT_HANDHELD;
+    SDL_AddFullscreenDisplayMode(display, &mode);
+
+    mode.w = SWITCH_WIDTH_DOCKED;
+    mode.h = SWITCH_HEIGHT_DOCKED;
+    SDL_AddFullscreenDisplayMode(display, &mode);
+
+    return true;
+}
+
+bool SWITCH_SetDisplayMode(SDL_VideoDevice *_this, SDL_VideoDisplay *display, SDL_DisplayMode *mode)
+{
+    return true;
+}
+
+bool SWITCH_CreateWindow(SDL_VideoDevice *_this, SDL_Window *window, SDL_PropertiesID create_props)
+{
+    SDL_WindowData *data;
+
+    // Allocate window internal data
+    data = (SDL_WindowData *)SDL_calloc(1, sizeof(SDL_WindowData));
+    if (!data) {
+        return false;
+    }
+
+    window->internal = data;
+
+    /* There is only one window on the Switch and libnx owns it. Rather than
+     * creating anything, take the default NWindow and size its framebuffer to
+     * match what SDL asked for. */
+    data->native_window = nwindowGetDefault();
+    if (!data->native_window) {
+        return SDL_SetError("SWITCH: Can't get the default NWindow");
+    }
+
+    if (R_FAILED(nwindowSetDimensions(data->native_window, (u32)window->w, (u32)window->h))) {
+        return SDL_SetError("SWITCH: nwindowSetDimensions() failed");
+    }
+
+    SDL_SetPointerProperty(SDL_GetWindowProperties(window), SDL_PROP_WINDOW_SWITCH_NWINDOW_POINTER, data->native_window);
+
+#ifdef SDL_VIDEO_OPENGL_EGL
+    if (window->flags & SDL_WINDOW_OPENGL) {
+        data->egl_surface = SDL_EGL_CreateSurface(_this, window, (NativeWindowType)data->native_window);
+        if (data->egl_surface == EGL_NO_SURFACE) {
+            return SDL_SetError("SWITCH: Can't create EGL surface");
+        }
+    } else {
+        data->egl_surface = EGL_NO_SURFACE;
+    }
+#endif
+
+    // the window always covers the whole screen
+    window->flags |= SDL_WINDOW_FULLSCREEN;
+
+    return true;
+}
+
+void SWITCH_DestroyWindow(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    SDL_WindowData *data = window->internal;
+
+    if (data) {
+#ifdef SDL_VIDEO_OPENGL_EGL
+        if (data->egl_surface != EGL_NO_SURFACE) {
+            SDL_EGL_DestroySurface(_this, data->egl_surface);
+        }
+#endif
+        // the NWindow belongs to libnx, so it is deliberately not destroyed here
+        SDL_free(data);
+    }
+    window->internal = NULL;
+}
+
+void SWITCH_SetWindowTitle(SDL_VideoDevice *_this, SDL_Window *window)
+{
+}
+
+bool SWITCH_SetWindowPosition(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    // the window is always fullscreen, so there is nothing to move
+    return SDL_Unsupported();
+}
+
+void SWITCH_SetWindowSize(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    SDL_WindowData *data = window->internal;
+
+    if (data && data->native_window) {
+        nwindowSetDimensions(data->native_window, (u32)window->w, (u32)window->h);
+    }
+}
+
+void SWITCH_ShowWindow(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    SDL_SetMouseFocus(window);
+    SDL_SetKeyboardFocus(window);
+}
+
+void SWITCH_HideWindow(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    SDL_SetMouseFocus(NULL);
+    SDL_SetKeyboardFocus(NULL);
+}
+
+/*****************************************************************************/
+// SDL event functions
+/*****************************************************************************/
+void SWITCH_PumpEvents(SDL_VideoDevice *_this)
+{
+    /* appletMainLoop() goes false once the system wants the applet gone -- the
+     * user quitting from the home menu, for instance. Surface that as a quit
+     * request so the application gets a chance to shut down cleanly. */
+    if (!appletMainLoop()) {
+        SDL_SendQuit();
+    }
+}
+
+#endif // SDL_VIDEO_DRIVER_SWITCH
