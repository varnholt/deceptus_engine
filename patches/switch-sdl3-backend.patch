diff --git a/src/audio/switch/SDL_switchaudio.c b/src/audio/switch/SDL_switchaudio.c
new file mode 100644
index 000000000..14fbcc528
--- /dev/null
+++ b/src/audio/switch/SDL_switchaudio.c
@@ -0,0 +1,157 @@
+/*
+  Simple DirectMedia Layer
+  Copyright (C) 1997-2026 Sam Lantinga <slouken@libsdl.org>
+
+  This software is provided 'as-is', without any express or implied
+  warranty.  In no event will the authors be held liable for any damages
+  arising from the use of this software.
+
+  Permission is granted to anyone to use this software for any purpose,
+  including commercial applications, and to alter it and redistribute it
+  freely, subject to the following restrictions:
+
+  1. The origin of this software must not be misrepresented; you must not
+     claim that you wrote the original software. If you use this software
+     in a product, an acknowledgment in the product documentation would be
+     appreciated but is not required.
+  2. Altered source versions must be plainly marked as such, and must not be
+     misrepresented as being the original software.
+  3. This notice may not be removed or altered from any source distribution.
+*/
+#include "SDL_internal.h"
+
+#ifdef SDL_AUDIO_DRIVER_SWITCH
+
+#include "../SDL_sysaudio.h"
+#include "SDL_switchaudio.h"
+
+/* libnx's audout takes whole page-aligned buffers, so both the address and the
+ * size have to be rounded up to 0x1000. */
+#define SWITCH_AUDIO_ALIGNMENT 0x1000
+#define SWITCH_AUDIO_ALIGN(value) (((value) + (SWITCH_AUDIO_ALIGNMENT - 1)) & ~(size_t)(SWITCH_AUDIO_ALIGNMENT - 1))
+
+static bool SWITCHAUD_OpenDevice(SDL_AudioDevice *device)
+{
+    if (device->recording) {
+        // recording would go through audin, which is not wired up
+        return SDL_Unsupported();
+    }
+
+    device->hidden = (struct SDL_PrivateAudioData *)SDL_calloc(1, sizeof(*device->hidden));
+    if (!device->hidden) {
+        return false;
+    }
+
+    if (R_FAILED(audoutInitialize())) {
+        return SDL_SetError("audoutInitialize() failed");
+    }
+
+    if (R_FAILED(audoutStartAudioOut())) {
+        audoutExit();
+        return SDL_SetError("audoutStartAudioOut() failed");
+    }
+
+    /* audout only ever accepts one format, so rather than negotiating, report the
+     * hardware's terms back to SDL and let it convert. */
+    device->spec.format = SDL_AUDIO_S16LE;
+    device->spec.freq = (int)audoutGetSampleRate();
+    device->spec.channels = (Uint8)audoutGetChannelCount();
+
+    SDL_UpdatedAudioDeviceFormat(device);
+
+    device->hidden->aligned_buffer_size = SWITCH_AUDIO_ALIGN((size_t)device->buffer_size);
+
+    const size_t total_size = device->hidden->aligned_buffer_size * SWITCH_AUDIO_BUFFER_COUNT;
+    device->hidden->rawbuf = (Uint8 *)SDL_aligned_alloc(SWITCH_AUDIO_ALIGNMENT, total_size);
+    if (!device->hidden->rawbuf) {
+        audoutStopAudioOut();
+        audoutExit();
+        return SDL_SetError("Couldn't allocate audio buffer");
+    }
+    SDL_memset(device->hidden->rawbuf, 0, total_size);
+
+    for (int buffer_index = 0; buffer_index < SWITCH_AUDIO_BUFFER_COUNT; buffer_index++) {
+        AudioOutBuffer *buffer = &device->hidden->buffers[buffer_index];
+        buffer->next = NULL;
+        buffer->buffer = device->hidden->rawbuf + ((size_t)buffer_index * device->hidden->aligned_buffer_size);
+        buffer->buffer_size = device->hidden->aligned_buffer_size;
+        buffer->data_size = (u64)device->buffer_size;
+        buffer->data_offset = 0;
+    }
+
+    device->hidden->next_buffer = 0;
+
+    return true;
+}
+
+static Uint8 *SWITCHAUD_GetDeviceBuf(SDL_AudioDevice *device, int *buffer_size)
+{
+    return (Uint8 *)device->hidden->buffers[device->hidden->next_buffer].buffer;
+}
+
+static bool SWITCHAUD_PlayDevice(SDL_AudioDevice *device, const Uint8 *buffer, int buffer_size)
+{
+    AudioOutBuffer *audio_buffer = &device->hidden->buffers[device->hidden->next_buffer];
+
+    audio_buffer->data_size = (u64)buffer_size;
+
+    if (R_FAILED(audoutAppendAudioOutBuffer(audio_buffer))) {
+        return SDL_SetError("audoutAppendAudioOutBuffer() failed");
+    }
+
+    device->hidden->next_buffer = (device->hidden->next_buffer + 1) % SWITCH_AUDIO_BUFFER_COUNT;
+
+    return true;
+}
+
+static bool SWITCHAUD_WaitDevice(SDL_AudioDevice *device)
+{
+    AudioOutBuffer *released_buffer = NULL;
+    u32 released_count = 0;
+
+    /* Block until the hardware hands a buffer back, which is what paces the
+     * audio thread. UINT64_MAX means wait indefinitely. */
+    if (R_FAILED(audoutWaitPlayFinish(&released_buffer, &released_count, UINT64_MAX))) {
+        return SDL_SetError("audoutWaitPlayFinish() failed");
+    }
+
+    return true;
+}
+
+static void SWITCHAUD_CloseDevice(SDL_AudioDevice *device)
+{
+    if (!device->hidden) {
+        return;
+    }
+
+    audoutStopAudioOut();
+    audoutExit();
+
+    if (device->hidden->rawbuf) {
+        SDL_aligned_free(device->hidden->rawbuf);
+        device->hidden->rawbuf = NULL;
+    }
+
+    SDL_free(device->hidden);
+    device->hidden = NULL;
+}
+
+static bool SWITCHAUD_Init(SDL_AudioDriverImpl *impl)
+{
+    impl->OpenDevice = SWITCHAUD_OpenDevice;
+    impl->PlayDevice = SWITCHAUD_PlayDevice;
+    impl->WaitDevice = SWITCHAUD_WaitDevice;
+    impl->GetDeviceBuf = SWITCHAUD_GetDeviceBuf;
+    impl->CloseDevice = SWITCHAUD_CloseDevice;
+
+    impl->OnlyHasDefaultPlaybackDevice = true;
+    impl->HasRecordingSupport = false;
+
+    return true;
+}
+
+AudioBootStrap SWITCHAUD_bootstrap = {
+    "switch", "Nintendo Switch audio driver", SWITCHAUD_Init, false, false
+};
+
+#endif // SDL_AUDIO_DRIVER_SWITCH
