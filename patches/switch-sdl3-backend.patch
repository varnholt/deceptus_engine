+static bool SWITCH_JoystickGetGamepadMapping(int device_index, SDL_GamepadMapping *out)
+{
+    /* There is only one possible mapping. The button indices are the HidNpadButton
+     * bit positions.
+     *
+     * Note the A/B and X/Y swap: Nintendo's physical layout puts A where a
+     * standard gamepad puts B. SDL gamepad roles are positional, so A maps to
+     * HidNpadButton_B (bit 1) and B maps to HidNpadButton_A (bit 0). */
+    *out = (SDL_GamepadMapping){
+        .a = { EMappingKind_Button, 1 },  // HidNpadButton_B, bottom face button
+        .b = { EMappingKind_Button, 0 },  // HidNpadButton_A, right face button
+        .x = { EMappingKind_Button, 3 },  // HidNpadButton_Y, left face button
+        .y = { EMappingKind_Button, 2 },  // HidNpadButton_X, top face button
+        .back = { EMappingKind_Button, 11 },  // HidNpadButton_Minus
+        .guide = { EMappingKind_None, 255 },
+        .start = { EMappingKind_Button, 10 }, // HidNpadButton_Plus
+        .leftstick = { EMappingKind_Button, 4 },  // HidNpadButton_StickL
+        .rightstick = { EMappingKind_Button, 5 }, // HidNpadButton_StickR
+        .leftshoulder = { EMappingKind_Button, 6 },  // HidNpadButton_L
+        .rightshoulder = { EMappingKind_Button, 7 }, // HidNpadButton_R
+        .dpup = { EMappingKind_Button, 13 },    // HidNpadButton_Up
+        .dpdown = { EMappingKind_Button, 15 },  // HidNpadButton_Down
+        .dpleft = { EMappingKind_Button, 12 },  // HidNpadButton_Left
+        .dpright = { EMappingKind_Button, 14 }, // HidNpadButton_Right
+        .misc1 = { EMappingKind_None, 255 },
+        .right_paddle1 = { EMappingKind_None, 255 },
+        .left_paddle1 = { EMappingKind_None, 255 },
+        .right_paddle2 = { EMappingKind_None, 255 },
+        .left_paddle2 = { EMappingKind_None, 255 },
+        .leftx = { EMappingKind_Axis, SWITCH_AXIS_LEFT_X },
+        .lefty = { EMappingKind_Axis, SWITCH_AXIS_LEFT_Y },
+        .rightx = { EMappingKind_Axis, SWITCH_AXIS_RIGHT_X },
+        .righty = { EMappingKind_Axis, SWITCH_AXIS_RIGHT_Y },
+        // ZL/ZR are digital on the Switch, so they are reported as buttons
+        .lefttrigger = { EMappingKind_Button, 8 },  // HidNpadButton_ZL
+        .righttrigger = { EMappingKind_Button, 9 }, // HidNpadButton_ZR
+    };
+    return true;
+}
