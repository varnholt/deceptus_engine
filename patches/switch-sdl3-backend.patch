diff --git a/src/joystick/switch/SDL_sysjoystick.c b/src/joystick/switch/SDL_sysjoystick.c
new file mode 100644
index 000000000..fb5dfe692
--- /dev/null
+++ b/src/joystick/switch/SDL_sysjoystick.c
@@ -0,0 +1,269 @@
+/*
+  Simple DirectMedia Layer
+  Copyright (C) 1997-2026 Sam Lantinga <slouken@libsdl.org>
+
+  This software is provided 'as-is', without any express or implied
+  warranty.  In no event will the authors be held liable for any damages
+  arising from the use of this software.
+
+  Permission is granted to anyone to use this software for any purpose,
+  including commercial applications, and to alter it and redistribute it
+  freely, subject to the following restrictions:
+
+  1. The origin of this software must not be misrepresented; you must not
+     claim that you wrote the original software. If you use this software
+     in a product, an acknowledgment in the product documentation would be
+     appreciated but is not required.
+  2. Altered source versions must be plainly marked as such, and must not be
+     misrepresented as being the original software.
+  3. This notice may not be removed or altered from any source distribution.
+*/
+#include "SDL_internal.h"
+
+#ifdef SDL_JOYSTICK_SWITCH
+
+// This is the Nintendo Switch implementation of the SDL joystick API
+
+#include <switch.h>
+
+#include "../SDL_sysjoystick.h"
+
+/* The first sixteen HidNpadButton bits are the ones every controller layout has
+ * in common: the four face buttons, both stick clicks, the four shoulder/trigger
+ * buttons, plus/minus, and the D-Pad. The bits above those describe stick
+ * directions that SDL derives from the axes itself, so they are not exposed. */
+#define SWITCH_BUTTON_COUNT 16
+#define SWITCH_AXIS_COUNT   4
+
+/* libnx reports analog sticks over the full signed 16-bit range already, so the
+ * values need no rescaling -- only the Y axes get flipped, because libnx points
+ * "up" positive while SDL points "up" negative. */
+#define SWITCH_AXIS_LEFT_X  0
+#define SWITCH_AXIS_LEFT_Y  1
+#define SWITCH_AXIS_RIGHT_X 2
+#define SWITCH_AXIS_RIGHT_Y 3
+
+static PadState switch_pad;
+static Uint64 switch_previous_buttons;
+
+static bool SWITCH_JoystickInit(void)
+{
+    /* One player, standard layout: this makes a single pair of Joy-Con report as
+     * one controller, which is what a single-player game wants. */
+    padConfigureInput(1, HidNpadStyleSet_NpadStandard);
+    padInitializeDefault(&switch_pad);
+
+    switch_previous_buttons = 0;
+
+    SDL_PrivateJoystickAdded(1);
+    return true;
+}
+
+static const char *SWITCH_JoystickGetDeviceName(int device_index)
+{
+    return "Nintendo Switch Controller";
+}
+
+static int SWITCH_JoystickGetCount(void)
+{
+    return 1;
+}
+
+static SDL_GUID SWITCH_JoystickGetDeviceGUID(int device_index)
+{
+    SDL_GUID guid = SDL_CreateJoystickGUIDForName("Nintendo Switch Controller");
+    return guid;
+}
+
+static SDL_JoystickID SWITCH_JoystickGetDeviceInstanceID(int device_index)
+{
+    return device_index + 1;
+}
+
+static bool SWITCH_JoystickOpen(SDL_Joystick *joystick, int device_index)
+{
+    joystick->nbuttons = SWITCH_BUTTON_COUNT;
+    joystick->naxes = SWITCH_AXIS_COUNT;
+    joystick->nhats = 0;
+
+    return true;
+}
+
+static bool SWITCH_JoystickSetSensorsEnabled(SDL_Joystick *joystick, bool enabled)
+{
+    return SDL_Unsupported();
+}
+
+static Sint16 SWITCH_ClampAxis(int value)
+{
+    // negating SDL_JOYSTICK_AXIS_MIN would overflow, so clamp before flipping
+    if (value < -SDL_JOYSTICK_AXIS_MAX) {
+        return -SDL_JOYSTICK_AXIS_MAX;
+    }
+    if (value > SDL_JOYSTICK_AXIS_MAX) {
+        return SDL_JOYSTICK_AXIS_MAX;
+    }
+    return (Sint16)value;
+}
+
+static void SWITCH_UpdateButtons(Uint64 timestamp, SDL_Joystick *joystick)
+{
+    const Uint64 current_buttons = padGetButtons(&switch_pad);
+    const Uint64 changed_buttons = current_buttons ^ switch_previous_buttons;
+
+    if (changed_buttons) {
+        for (Uint8 button_index = 0; button_index < SWITCH_BUTTON_COUNT; button_index++) {
+            const Uint64 button_mask = BITL(button_index);
+            if (changed_buttons & button_mask) {
+                SDL_SendJoystickButton(timestamp, joystick, button_index,
+                                       (current_buttons & button_mask) ? true : false);
+            }
+        }
+    }
+
+    switch_previous_buttons = current_buttons;
+}
+
+static void SWITCH_UpdateSticks(Uint64 timestamp, SDL_Joystick *joystick)
+{
+    const HidAnalogStickState left_stick = padGetStickPos(&switch_pad, 0);
+    const HidAnalogStickState right_stick = padGetStickPos(&switch_pad, 1);
+
+    SDL_SendJoystickAxis(timestamp, joystick, SWITCH_AXIS_LEFT_X, SWITCH_ClampAxis(left_stick.x));
+    SDL_SendJoystickAxis(timestamp, joystick, SWITCH_AXIS_LEFT_Y, SWITCH_ClampAxis(-left_stick.y));
+    SDL_SendJoystickAxis(timestamp, joystick, SWITCH_AXIS_RIGHT_X, SWITCH_ClampAxis(right_stick.x));
+    SDL_SendJoystickAxis(timestamp, joystick, SWITCH_AXIS_RIGHT_Y, SWITCH_ClampAxis(-right_stick.y));
+}
+
+static void SWITCH_JoystickUpdate(SDL_Joystick *joystick)
+{
+    const Uint64 timestamp = SDL_GetTicksNS();
+
+    padUpdate(&switch_pad);
+
+    SWITCH_UpdateButtons(timestamp, joystick);
+    SWITCH_UpdateSticks(timestamp, joystick);
+}
